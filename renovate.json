{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration enforcing StateRAMP/CJIS vulnerability remediation timelines, pinned digests, and strict hash verification across Bun, Python, and OCI base images.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMultipleMajorReleases"
  ],
  "timezone": "Etc/UTC",
  "pinDigests": true,
  "commitMessagePrefix": "chore(deps):",
  "labels": ["dependencies", "compliance-stateramp-cjis"],
  "assignees": ["@security-team", "@platform-lead"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security-remediation", "priority-high", "sla-15-days"],
    "schedule": ["at any time"],
    "commitMessagePrefix": "fix(security):",
    "dependencyDashboardApproval": false,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Base Docker image updates must preserve exact semantic versions AND registry-verified SHA256 digests per AGENTS.md contract.",
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "groupName": "oci-base-images",
      "commitMessageTopic": "base image {{depName}}",
      "schedule": ["before 6am on Monday"],
      "rebaseWhen": "auto"
    },
    {
      "description": "Python runtime dependencies in datastore/requirements.lock requiring exact wheel hashes and musllinux targets.",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["datastore/requirements.lock"],
      "groupName": "python-datastore-deps",
      "schedule": ["before 6am on Monday"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Bun monorepo and web application dependencies.",
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json", "app/package.json"],
      "groupName": "bun-monorepo-deps",
      "schedule": ["before 6am on Monday"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Fast-track patch updates for known critical/high security vulnerabilities to satisfy StateRAMP RA-5 and CJIS Section 5.13 SLAs.",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track base images pinned in documentation docs/image-pins.md",
      "fileMatch": ["^docs/image-pins\\.md$"],
      "matchStrings": [
        "`(?<depName>[a-z0-9._/-]+):(?<currentValue>[0-9.-]+(?:-alpine[0-9.]+)?)` \\| `(?<currentDigest>[a-f0-9]{64})`"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
