# Future server-side interface only. Never expose these through VITE_* variables.
# No current entry point loads this file or connects to a datastore.
DATASTORE_HOST=datastore.example.invalid
DATASTORE_PORT=5432
DATASTORE_NAME=demo
DATASTORE_SSLMODE=verify-full
DATASTORE_USERNAME_FILE=/var/run/secrets/datastore/username
DATASTORE_PASSWORD_FILE=/var/run/secrets/datastore/password
DATASTORE_SSLROOTCERT=/var/run/secrets/datastore/ca.crt
