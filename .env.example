DATASTORE_HOST=postgres-cluster-rw.demo.svc.cluster.local
DATASTORE_PORT=5432
DATASTORE_NAME=demo
DATASTORE_SSLMODE=verify-full
DATASTORE_USERNAME_FILE=/var/run/secrets/datastore/username
DATASTORE_PASSWORD_FILE=/var/run/secrets/datastore/password
DATASTORE_SSLROOTCERT=/var/run/secrets/datastore/ca.crt
