{
  "name": "local-kubernetes-demo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "bun run --filter @local-k8s-demo/web dev",
    "dev:api": "python3 api/main.py",
    "build": "bun run --filter @local-k8s-demo/web build",
    "preview": "bun run --filter @local-k8s-demo/web preview",
    "image:web": "bun run build && docker build -t web-app:0.1.0 -f app/Dockerfile .",
    "image:api": "docker build -t api:0.1.0 -f api/Dockerfile .",
    "image:collector": "docker build -t collector:0.1.0 -f collector/Dockerfile .",
    "k8s:render": "bun scripts/render-k8s.mjs"
  }
}
